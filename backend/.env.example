# ------------------------------------------------------------------
# Climate Cardinals KNUST — Backend environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000

# PostgreSQL connection string used by Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/climate_cardinals?schema=public"

# JSON Web Token settings
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Comma-separated list of allowed CORS origins (the static frontend origins).
# Use * only for local development.
CORS_ORIGINS="http://localhost:5500,http://127.0.0.1:5500"

# Bootstrap admin account created by the seed script
SEED_ADMIN_EMAIL="admin@climatecardinalsknust.org"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Chapter Admin"
